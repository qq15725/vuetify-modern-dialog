{
  "name": "vuetify-modern-dialog",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.18.1",
  "description": "Starter template for TypeScript library",
  "author": "wxm",
  "license": "MIT",
  "homepage": "https://github.com/qq15725/vuetify-modern-dialog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq15725/vuetify-modern-dialog.git"
  },
  "bugs": {
    "url": "https://github.com/qq15725/vuetify-modern-dialog/issues"
  },
  "keywords": [
    "starter",
    "template",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.js",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:code": "vite build",
    "build:tsc": "NODE_ENV=production vue-tsc --emitDeclarationOnly --project tsconfig.build.json",
    "build": "pnpm build:code && pnpm build:tsc",
    "dev": "MODE=local vite playground",
    "lint": "eslint src",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
    "release": "bumpp package.json --commit \"release: v%s\" --push --all --tag",
    "start": "esno src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@types/node": "^24.7.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "bumpp": "^10.3.1",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.37.0",
    "lint-staged": "^16.2.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.1",
    "vuetify": "^3.10.5"
  },
  "peerDependencies": {
    "typescript": ">=4.7",
    "vue": "^3.5.0",
    "vuetify": "^3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": ""
  }
}
