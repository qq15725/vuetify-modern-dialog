{
  "name": "vuetify-modern-dialog",
  "type": "module",
  "version": "0.0.6",
  "packageManager": "pnpm@10.18.1",
  "description": "Dialogs in vuetify 3",
  "author": "wxm",
  "license": "MIT",
  "homepage": "https://github.com/qq15725/vuetify-modern-dialog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq15725/vuetify-modern-dialog.git"
  },
  "bugs": {
    "url": "https://github.com/qq15725/vuetify-modern-dialog/issues"
  },
  "keywords": [
    "vuetify",
    "dialog",
    "typescript"
  ],
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles": {
      "default": "./dist/index.css"
    },
    "./*.mjs": "./*.js",
    "./*": "./*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "typings": "dist/index.d.ts",
  "types": "dist/index.d.ts",
  "styles": "dist/index.css",
  "typesVersions": {
    "*": {
      "*": [
        "*",
        "dist/*",
        "dist/*.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:code": "vite build",
    "build:tsc": "NODE_ENV=production vue-tsc --emitDeclarationOnly --project tsconfig.build.json",
    "build": "pnpm build:code && pnpm build:tsc",
    "dev": "MODE=local vite playground",
    "lint": "eslint src",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
    "release": "bumpp package.json --commit \"release: v%s\" --push --all --tag",
    "start": "esno src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@types/node": "^25.0.6",
    "@vitejs/plugin-vue": "^6.0.3",
    "bumpp": "^10.3.2",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.16",
    "vue": "^3.5.26",
    "vue-tsc": "^3.2.2",
    "vuetify": "^3.11.6"
  },
  "peerDependencies": {
    "typescript": ">=4.7",
    "vue": "^3.5.0",
    "vuetify": "^3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
